<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://medellin.demo/bpmn" exporter="generar_bpmn.py">
  <collaboration id="Collab_1">
    <participant id="Pool_1" name="AS-IS — Devoluciones y compensaciones — Subsecretaría de Ingresos de Medellín" processRef="Proceso_1"/>
  </collaboration>
  <process id="Proceso_1" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="L_contrib" name="Contribuyente">
        <flowNodeRef>A_Inicio</flowNodeRef>
        <flowNodeRef>A_Presentar</flowNodeRef>
        <flowNodeRef>A_Subsanar</flowNodeRef>
        <flowNodeRef>A_Interponer_recurso</flowNodeRef>
      </lane>
      <lane id="L_radic" name="Radicación (Mercurio)">
        <flowNodeRef>A_Radicar</flowNodeRef>
      </lane>
      <lane id="L_lider" name="Líder y revisores">
        <flowNodeRef>A_Repartir</flowNodeRef>
        <flowNodeRef>A_Revisar_proyecto</flowNodeRef>
        <flowNodeRef>A_Firmar</flowNodeRef>
      </lane>
      <lane id="L_sust" name="Sustanciadores (85 % contratistas)">
        <flowNodeRef>A_Revisar_requisitos</flowNodeRef>
        <flowNodeRef>A_GW_completa</flowNodeRef>
        <flowNodeRef>A_Auto_inadmisorio</flowNodeRef>
        <flowNodeRef>A_Proyectar_rechazo</flowNodeRef>
        <flowNodeRef>A_Revisar_subsanacion</flowNodeRef>
        <flowNodeRef>A_Consolidar</flowNodeRef>
        <flowNodeRef>A_Analizar</flowNodeRef>
        <flowNodeRef>A_Proyectar_resolucion</flowNodeRef>
        <flowNodeRef>A_Ejecutoria</flowNodeRef>
      </lane>
      <lane id="L_otras" name="Otras unidades de Ingresos">
        <flowNodeRef>A_Solicitar_info</flowNodeRef>
        <flowNodeRef>A_Registrar_SAP</flowNodeRef>
        <flowNodeRef>A_GW_pago</flowNodeRef>
        <flowNodeRef>A_Fin_compensada</flowNodeRef>
        <flowNodeRef>A_Cruce_cartera</flowNodeRef>
      </lane>
      <lane id="L_notif" name="Notificaciones (Apoyo a Ingresos)">
        <flowNodeRef>A_Notificar_inadmision</flowNodeRef>
        <flowNodeRef>A_Notificar_rechazo</flowNodeRef>
        <flowNodeRef>A_Fin_rechazo</flowNodeRef>
        <flowNodeRef>A_Notificar_resolucion</flowNodeRef>
        <flowNodeRef>A_GW_recurso</flowNodeRef>
        <flowNodeRef>A_Notificar_recurso</flowNodeRef>
        <flowNodeRef>A_Fin_recurso</flowNodeRef>
      </lane>
      <lane id="L_jur" name="Unidad Jurídica">
        <flowNodeRef>A_Resolver_recurso</flowNodeRef>
      </lane>
      <lane id="L_fin" name="Presupuesto, contabilidad y Tesorería">
        <flowNodeRef>A_Orden_pago</flowNodeRef>
        <flowNodeRef>A_Pagar</flowNodeRef>
        <flowNodeRef>A_Fin_pagada</flowNodeRef>
      </lane>
      <lane id="L_sis" name="Sistemas sin integrar">
        <flowNodeRef>S_Mercurio</flowNodeRef>
        <flowNodeRef>S_Excel</flowNodeRef>
        <flowNodeRef>S_Visor</flowNodeRef>
        <flowNodeRef>S_Correo</flowNodeRef>
        <flowNodeRef>S_NAS</flowNodeRef>
        <flowNodeRef>S_SAP</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="A_Inicio" name="Solicitud">
      <outgoing>F000_A_Inicio_A_Presentar</outgoing>
    </startEvent>
    <task id="A_Presentar" name="Presentar solicitud y anexos">
      <incoming>F000_A_Inicio_A_Presentar</incoming>
      <outgoing>F001_A_Presentar_A_Radicar</outgoing>
    </task>
    <task id="A_Radicar" name="Radicar en Mercurio">
      <incoming>F001_A_Presentar_A_Radicar</incoming>
      <outgoing>F002_A_Radicar_A_Repartir</outgoing>
    </task>
    <task id="A_Repartir" name="Repartir por Excel o correo">
      <incoming>F002_A_Radicar_A_Repartir</incoming>
      <outgoing>F003_A_Repartir_A_Revisar_requisitos</outgoing>
    </task>
    <task id="A_Revisar_requisitos" name="Revisar requisitos y competencia">
      <incoming>F003_A_Repartir_A_Revisar_requisitos</incoming>
      <outgoing>F004_A_Revisar_requisitos_A_GW_completa</outgoing>
    </task>
    <exclusiveGateway id="A_GW_completa" name="¿Procede?">
      <incoming>F004_A_Revisar_requisitos_A_GW_completa</incoming>
      <outgoing>F005_A_GW_completa_A_Auto_inadmisorio</outgoing>
      <outgoing>F006_A_GW_completa_A_Proyectar_rechazo</outgoing>
      <outgoing>F007_A_GW_completa_A_Consolidar</outgoing>
    </exclusiveGateway>
    <task id="A_Auto_inadmisorio" name="Elaborar auto inadmisorio en Word/NAS">
      <incoming>F005_A_GW_completa_A_Auto_inadmisorio</incoming>
      <outgoing>F008_A_Auto_inadmisorio_A_Notificar_inadmision</outgoing>
    </task>
    <task id="A_Proyectar_rechazo" name="Proyectar rechazo (firma del líder)">
      <incoming>F006_A_GW_completa_A_Proyectar_rechazo</incoming>
      <outgoing>F012_A_Proyectar_rechazo_A_Notificar_rechazo</outgoing>
    </task>
    <task id="A_Notificar_inadmision" name="Notificar inadmisión">
      <incoming>F008_A_Auto_inadmisorio_A_Notificar_inadmision</incoming>
      <outgoing>F009_A_Notificar_inadmision_A_Subsanar</outgoing>
    </task>
    <task id="A_Notificar_rechazo" name="Notificar rechazo">
      <incoming>F012_A_Proyectar_rechazo_A_Notificar_rechazo</incoming>
      <outgoing>F013_A_Notificar_rechazo_A_Fin_rechazo</outgoing>
    </task>
    <endEvent id="A_Fin_rechazo" name="Rechazada">
      <incoming>F013_A_Notificar_rechazo_A_Fin_rechazo</incoming>
    </endEvent>
    <task id="A_Subsanar" name="Subsanar dentro del término">
      <incoming>F009_A_Notificar_inadmision_A_Subsanar</incoming>
      <outgoing>F010_A_Subsanar_A_Revisar_subsanacion</outgoing>
    </task>
    <task id="A_Revisar_subsanacion" name="Revisar subsanación">
      <incoming>F010_A_Subsanar_A_Revisar_subsanacion</incoming>
      <outgoing>F011_A_Revisar_subsanacion_A_Consolidar</outgoing>
    </task>
    <task id="A_Consolidar" name="Consolidar información a mano (Mercurio, NAS, Visor, Excel)">
      <incoming>F007_A_GW_completa_A_Consolidar</incoming>
      <incoming>F011_A_Revisar_subsanacion_A_Consolidar</incoming>
      <outgoing>F014_A_Consolidar_A_Solicitar_info</outgoing>
    </task>
    <task id="A_Solicitar_info" name="Pedir estado de cuenta o cartera por correo">
      <incoming>F014_A_Consolidar_A_Solicitar_info</incoming>
      <outgoing>F015_A_Solicitar_info_A_Analizar</outgoing>
    </task>
    <task id="A_Analizar" name="Analizar y verificar el saldo">
      <incoming>F015_A_Solicitar_info_A_Analizar</incoming>
      <outgoing>F016_A_Analizar_A_Revisar_proyecto</outgoing>
    </task>
    <task id="A_Revisar_proyecto" name="Revisar proyecto de decisión">
      <incoming>F016_A_Analizar_A_Revisar_proyecto</incoming>
      <outgoing>F017_A_Revisar_proyecto_A_Proyectar_resolucion</outgoing>
    </task>
    <task id="A_Proyectar_resolucion" name="Proyectar resolución en Word/NAS">
      <incoming>F017_A_Revisar_proyecto_A_Proyectar_resolucion</incoming>
      <outgoing>F018_A_Proyectar_resolucion_A_Firmar</outgoing>
    </task>
    <task id="A_Firmar" name="Revisar y firmar">
      <incoming>F018_A_Proyectar_resolucion_A_Firmar</incoming>
      <outgoing>F019_A_Firmar_A_Notificar_resolucion</outgoing>
    </task>
    <task id="A_Notificar_resolucion" name="Notificar resolución">
      <incoming>F019_A_Firmar_A_Notificar_resolucion</incoming>
      <outgoing>F020_A_Notificar_resolucion_A_GW_recurso</outgoing>
    </task>
    <exclusiveGateway id="A_GW_recurso" name="¿Recurso?">
      <incoming>F020_A_Notificar_resolucion_A_GW_recurso</incoming>
      <outgoing>F021_A_GW_recurso_A_Interponer_recurso</outgoing>
      <outgoing>F025_A_GW_recurso_A_Ejecutoria</outgoing>
    </exclusiveGateway>
    <task id="A_Interponer_recurso" name="Interponer recurso">
      <incoming>F021_A_GW_recurso_A_Interponer_recurso</incoming>
      <outgoing>F022_A_Interponer_recurso_A_Resolver_recurso</outgoing>
    </task>
    <task id="A_Resolver_recurso" name="Resolver recurso">
      <incoming>F022_A_Interponer_recurso_A_Resolver_recurso</incoming>
      <outgoing>F023_A_Resolver_recurso_A_Notificar_recurso</outgoing>
    </task>
    <task id="A_Notificar_recurso" name="Notificar decisión del recurso">
      <incoming>F023_A_Resolver_recurso_A_Notificar_recurso</incoming>
      <outgoing>F024_A_Notificar_recurso_A_Fin_recurso</outgoing>
    </task>
    <endEvent id="A_Fin_recurso" name="Recurso resuelto">
      <incoming>F024_A_Notificar_recurso_A_Fin_recurso</incoming>
    </endEvent>
    <task id="A_Ejecutoria" name="Controlar ejecutoria en Excel">
      <incoming>F025_A_GW_recurso_A_Ejecutoria</incoming>
      <outgoing>F026_A_Ejecutoria_A_Registrar_SAP</outgoing>
    </task>
    <task id="A_Registrar_SAP" name="Pedir a otra área el registro en cuenta corriente">
      <incoming>F026_A_Ejecutoria_A_Registrar_SAP</incoming>
      <outgoing>F027_A_Registrar_SAP_A_GW_pago</outgoing>
    </task>
    <exclusiveGateway id="A_GW_pago" name="¿Saldo a pagar?">
      <incoming>F027_A_Registrar_SAP_A_GW_pago</incoming>
      <outgoing>F028_A_GW_pago_A_Fin_compensada</outgoing>
      <outgoing>F029_A_GW_pago_A_Cruce_cartera</outgoing>
      <outgoing>F030_A_GW_pago_A_Orden_pago</outgoing>
    </exclusiveGateway>
    <endEvent id="A_Fin_compensada" name="Compensada">
      <incoming>F028_A_GW_pago_A_Fin_compensada</incoming>
    </endEvent>
    <task id="A_Cruce_cartera" name="Cruzar con cartera (Títulos, Cobranzas)">
      <incoming>F029_A_GW_pago_A_Cruce_cartera</incoming>
      <outgoing>F031_A_Cruce_cartera_A_Orden_pago</outgoing>
    </task>
    <task id="A_Orden_pago" name="Orden de pago y registro contable">
      <incoming>F030_A_GW_pago_A_Orden_pago</incoming>
      <incoming>F031_A_Cruce_cartera_A_Orden_pago</incoming>
      <outgoing>F032_A_Orden_pago_A_Pagar</outgoing>
    </task>
    <task id="A_Pagar" name="Pagar y enviar evidencia por correo">
      <incoming>F032_A_Orden_pago_A_Pagar</incoming>
      <outgoing>F033_A_Pagar_A_Fin_pagada</outgoing>
    </task>
    <endEvent id="A_Fin_pagada" name="Pagada">
      <incoming>F033_A_Pagar_A_Fin_pagada</incoming>
    </endEvent>
    <task id="S_Mercurio" name="Mercurio (intermitente)">
    </task>
    <task id="S_Excel" name="Excel y tableros">
    </task>
    <task id="S_Visor" name="Visor 360 / NAS">
    </task>
    <task id="S_Correo" name="Correo">
    </task>
    <task id="S_NAS" name="NAS (actos)">
    </task>
    <task id="S_SAP" name="SAP (solo predial)">
    </task>
