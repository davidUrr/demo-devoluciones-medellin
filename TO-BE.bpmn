<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://medellin.demo/bpmn" exporter="generar_bpmn.py">
  <collaboration id="Collab_1">
    <participant id="Pool_1" name="TO-BE — Devoluciones y compensaciones con expediente único — Subsecretaría de Ingresos de Medellín" processRef="Proceso_1"/>
  </collaboration>
  <process id="Proceso_1" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="L_contrib" name="Contribuyente">
        <flowNodeRef>T_Inicio</flowNodeRef>
        <flowNodeRef>T_Presentar</flowNodeRef>
        <flowNodeRef>T_Subsanar</flowNodeRef>
        <flowNodeRef>T_Interponer_recurso</flowNodeRef>
      </lane>
      <lane id="L_plat" name="Plataforma de expediente (automático)">
        <flowNodeRef>T_Crear_expediente</flowNodeRef>
        <flowNodeRef>T_Repartir</flowNodeRef>
        <flowNodeRef>T_Vista_360</flowNodeRef>
        <flowNodeRef>T_Ejecutoria</flowNodeRef>
        <flowNodeRef>T_Cierre</flowNodeRef>
        <flowNodeRef>T_Fin_pagada</flowNodeRef>
      </lane>
      <lane id="L_lider" name="Líder y revisores">
        <flowNodeRef>T_Revisar_proyecto</flowNodeRef>
        <flowNodeRef>T_Firmar</flowNodeRef>
      </lane>
      <lane id="L_sust" name="Sustanciadores">
        <flowNodeRef>T_Checklist</flowNodeRef>
        <flowNodeRef>T_GW_completa</flowNodeRef>
        <flowNodeRef>T_Requerimiento</flowNodeRef>
        <flowNodeRef>T_Proyectar_rechazo</flowNodeRef>
        <flowNodeRef>T_Validar_subsanacion</flowNodeRef>
        <flowNodeRef>T_Analizar</flowNodeRef>
        <flowNodeRef>T_Generar_resolucion</flowNodeRef>
      </lane>
      <lane id="L_otras" name="Otras unidades (solicitudes con ANS)">
        <flowNodeRef>T_Solicitud_ANS</flowNodeRef>
        <flowNodeRef>T_Registrar_SAP</flowNodeRef>
        <flowNodeRef>T_GW_pago</flowNodeRef>
        <flowNodeRef>T_Cierre_compensada</flowNodeRef>
        <flowNodeRef>T_Cruce_cartera</flowNodeRef>
      </lane>
      <lane id="L_notif" name="Notificaciones (Apoyo a Ingresos)">
        <flowNodeRef>T_Notificar_inadmision</flowNodeRef>
        <flowNodeRef>T_Notificar_rechazo</flowNodeRef>
        <flowNodeRef>T_Fin_rechazo</flowNodeRef>
        <flowNodeRef>T_Notificar_resolucion</flowNodeRef>
        <flowNodeRef>T_GW_recurso</flowNodeRef>
        <flowNodeRef>T_Notificar_recurso</flowNodeRef>
        <flowNodeRef>T_Fin_recurso</flowNodeRef>
      </lane>
      <lane id="L_jur" name="Unidad Jurídica">
        <flowNodeRef>T_Resolver_recurso</flowNodeRef>
      </lane>
      <lane id="L_fin" name="Presupuesto, contabilidad y Tesorería">
        <flowNodeRef>T_Orden_pago</flowNodeRef>
        <flowNodeRef>T_Pagar</flowNodeRef>
      </lane>
      <lane id="L_sis" name="Sistemas conectados progresivamente">
        <flowNodeRef>S_Mercurio</flowNodeRef>
        <flowNodeRef>S_Tablero</flowNodeRef>
        <flowNodeRef>S_Lago</flowNodeRef>
        <flowNodeRef>S_Plantillas</flowNodeRef>
        <flowNodeRef>S_SAP</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="T_Inicio" name="Solicitud">
      <outgoing>F000_T_Inicio_T_Presentar</outgoing>
    </startEvent>
    <task id="T_Presentar" name="Presentar solicitud y anexos">
      <incoming>F000_T_Inicio_T_Presentar</incoming>
      <outgoing>F001_T_Presentar_T_Crear_expediente</outgoing>
    </task>
    <task id="T_Crear_expediente" name="Crear expediente desde el radicado">
      <incoming>F001_T_Presentar_T_Crear_expediente</incoming>
      <outgoing>F002_T_Crear_expediente_T_Repartir</outgoing>
    </task>
    <task id="T_Repartir" name="Repartir por reglas y carga">
      <incoming>F002_T_Crear_expediente_T_Repartir</incoming>
      <outgoing>F003_T_Repartir_T_Checklist</outgoing>
    </task>
    <task id="T_Checklist" name="Checklist de requisitos por renta">
      <incoming>F003_T_Repartir_T_Checklist</incoming>
      <outgoing>F004_T_Checklist_T_GW_completa</outgoing>
    </task>
    <exclusiveGateway id="T_GW_completa" name="¿Procede?">
      <incoming>F004_T_Checklist_T_GW_completa</incoming>
      <outgoing>F005_T_GW_completa_T_Requerimiento</outgoing>
      <outgoing>F006_T_GW_completa_T_Proyectar_rechazo</outgoing>
      <outgoing>F007_T_GW_completa_T_Vista_360</outgoing>
    </exclusiveGateway>
    <task id="T_Requerimiento" name="Requerimiento desde plantilla">
      <incoming>F005_T_GW_completa_T_Requerimiento</incoming>
      <outgoing>F008_T_Requerimiento_T_Notificar_inadmision</outgoing>
    </task>
    <task id="T_Proyectar_rechazo" name="Rechazo desde plantilla (firma del líder)">
      <incoming>F006_T_GW_completa_T_Proyectar_rechazo</incoming>
      <outgoing>F012_T_Proyectar_rechazo_T_Notificar_rechazo</outgoing>
    </task>
    <task id="T_Notificar_inadmision" name="Notificar y trazar inadmisión">
      <incoming>F008_T_Requerimiento_T_Notificar_inadmision</incoming>
      <outgoing>F009_T_Notificar_inadmision_T_Subsanar</outgoing>
    </task>
    <task id="T_Notificar_rechazo" name="Notificar y trazar rechazo">
      <incoming>F012_T_Proyectar_rechazo_T_Notificar_rechazo</incoming>
      <outgoing>F013_T_Notificar_rechazo_T_Fin_rechazo</outgoing>
    </task>
    <endEvent id="T_Fin_rechazo" name="Rechazada">
      <incoming>F013_T_Notificar_rechazo_T_Fin_rechazo</incoming>
    </endEvent>
    <task id="T_Subsanar" name="Subsanar dentro del término">
      <incoming>F009_T_Notificar_inadmision_T_Subsanar</incoming>
      <outgoing>F010_T_Subsanar_T_Validar_subsanacion</outgoing>
    </task>
    <task id="T_Validar_subsanacion" name="Validar subsanación con checklist">
      <incoming>F010_T_Subsanar_T_Validar_subsanacion</incoming>
      <outgoing>F011_T_Validar_subsanacion_T_Vista_360</outgoing>
    </task>
    <task id="T_Vista_360" name="Vista 360 del contribuyente (solo consulta)">
      <incoming>F007_T_GW_completa_T_Vista_360</incoming>
      <incoming>F011_T_Validar_subsanacion_T_Vista_360</incoming>
      <outgoing>F014_T_Vista_360_T_Solicitud_ANS</outgoing>
    </task>
    <task id="T_Solicitud_ANS" name="Atender solicitud con ANS y seguimiento">
      <incoming>F014_T_Vista_360_T_Solicitud_ANS</incoming>
      <outgoing>F015_T_Solicitud_ANS_T_Analizar</outgoing>
    </task>
    <task id="T_Analizar" name="Analizar y verificar el saldo">
      <incoming>F015_T_Solicitud_ANS_T_Analizar</incoming>
      <outgoing>F016_T_Analizar_T_Revisar_proyecto</outgoing>
    </task>
    <task id="T_Revisar_proyecto" name="Revisar proyecto en la bandeja">
      <incoming>F016_T_Analizar_T_Revisar_proyecto</incoming>
      <outgoing>F017_T_Revisar_proyecto_T_Generar_resolucion</outgoing>
    </task>
    <task id="T_Generar_resolucion" name="Generar resolución desde plantilla">
      <incoming>F017_T_Revisar_proyecto_T_Generar_resolucion</incoming>
      <outgoing>F018_T_Generar_resolucion_T_Firmar</outgoing>
    </task>
    <task id="T_Firmar" name="Revisar y firmar con versión controlada">
      <incoming>F018_T_Generar_resolucion_T_Firmar</incoming>
      <outgoing>F019_T_Firmar_T_Notificar_resolucion</outgoing>
    </task>
    <task id="T_Notificar_resolucion" name="Notificar y trazar resolución">
      <incoming>F019_T_Firmar_T_Notificar_resolucion</incoming>
      <outgoing>F020_T_Notificar_resolucion_T_GW_recurso</outgoing>
    </task>
    <exclusiveGateway id="T_GW_recurso" name="¿Recurso?">
      <incoming>F020_T_Notificar_resolucion_T_GW_recurso</incoming>
      <outgoing>F021_T_GW_recurso_T_Interponer_recurso</outgoing>
      <outgoing>F025_T_GW_recurso_T_Ejecutoria</outgoing>
    </exclusiveGateway>
    <task id="T_Interponer_recurso" name="Interponer recurso">
      <incoming>F021_T_GW_recurso_T_Interponer_recurso</incoming>
      <outgoing>F022_T_Interponer_recurso_T_Resolver_recurso</outgoing>
    </task>
    <task id="T_Resolver_recurso" name="Resolver recurso con relatoría">
      <incoming>F022_T_Interponer_recurso_T_Resolver_recurso</incoming>
      <outgoing>F023_T_Resolver_recurso_T_Notificar_recurso</outgoing>
    </task>
    <task id="T_Notificar_recurso" name="Notificar decisión del recurso">
      <incoming>F023_T_Resolver_recurso_T_Notificar_recurso</incoming>
      <outgoing>F024_T_Notificar_recurso_T_Fin_recurso</outgoing>
    </task>
    <endEvent id="T_Fin_recurso" name="Recurso resuelto">
      <incoming>F024_T_Notificar_recurso_T_Fin_recurso</incoming>
    </endEvent>
    <task id="T_Ejecutoria" name="Motor de términos: ejecutoria">
      <incoming>F025_T_GW_recurso_T_Ejecutoria</incoming>
      <outgoing>F026_T_Ejecutoria_T_Registrar_SAP</outgoing>
    </task>
    <task id="T_Registrar_SAP" name="Registrar en cuenta corriente (tarea con ANS)">
      <incoming>F026_T_Ejecutoria_T_Registrar_SAP</incoming>
      <outgoing>F027_T_Registrar_SAP_T_GW_pago</outgoing>
    </task>
    <exclusiveGateway id="T_GW_pago" name="¿Saldo a pagar?">
      <incoming>F027_T_Registrar_SAP_T_GW_pago</incoming>
      <outgoing>F028_T_GW_pago_T_Cierre_compensada</outgoing>
      <outgoing>F029_T_GW_pago_T_Cruce_cartera</outgoing>
      <outgoing>F030_T_GW_pago_T_Orden_pago</outgoing>
    </exclusiveGateway>
    <endEvent id="T_Cierre_compensada" name="Compensada">
      <incoming>F028_T_GW_pago_T_Cierre_compensada</incoming>
    </endEvent>
    <task id="T_Cruce_cartera" name="Cruzar con cartera en la vista 360">
      <incoming>F029_T_GW_pago_T_Cruce_cartera</incoming>
      <outgoing>F031_T_Cruce_cartera_T_Orden_pago</outgoing>
    </task>
    <task id="T_Orden_pago" name="Orden de pago y registro contable">
      <incoming>F030_T_GW_pago_T_Orden_pago</incoming>
      <incoming>F031_T_Cruce_cartera_T_Orden_pago</incoming>
      <outgoing>F032_T_Orden_pago_T_Pagar</outgoing>
    </task>
    <task id="T_Pagar" name="Pagar y adjuntar evidencia">
      <incoming>F032_T_Orden_pago_T_Pagar</incoming>
      <outgoing>F033_T_Pagar_T_Cierre</outgoing>
    </task>
    <task id="T_Cierre" name="Cerrar expediente y bitácora">
      <incoming>F033_T_Pagar_T_Cierre</incoming>
      <outgoing>F034_T_Cierre_T_Fin_pagada</outgoing>
    </task>
    <endEvent id="T_Fin_pagada" name="Pagada">
      <incoming>F034_T_Cierre_T_Fin_pagada</incoming>
    </endEvent>
    <task id="S_Mercurio" name="Mercurio (radicado)">
    </task>
    <task id="S_Tablero" name="Tablero, alertas y bitácora">
    </task>
    <task id="S_Lago" name="Lago de datos / Power BI (consulta)">
    </task>
    <task id="S_Plantillas" name="Plantillas y NAS">
    </task>
    <task id="S_SAP" name="SAP (vía Centro de Competencias)">
    </task>
